none;align=left;fontSize=11;" vertex="1" parent="c66"><mxGeometry x="40" y="74" width="120" height="22" as="geometry"/></mxCell><mxCell id="c75" value="timestamptz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;text;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="c66"><mxGeometry x="160" y="74" width="90" height="22" as="geometry"/></mxCell><mxCell id="c76" value="tiene" style="html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#1f4e79;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c77" value="abre" style="html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#1f4e79;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="228"/><mxPoint x="380" y="404"/></Array></mxGeometry></mxCell><mxCell id="c78" value="afecta a" style="html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#1f4e79;startArrow=ERzeroToOne;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="c22" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c79" value="usuario (sin clave foránea)" style="html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;rounded=0;html=1;dashed=1;endArrow=open;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#888888;" edge="1" parent="1" source="c66" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c80" value="&lt;b&gt;Relaciones&lt;/b&gt;&lt;br&gt;· Un cliente tiene 0..N cajas; cada caja es de un solo cliente.&lt;br&gt;· Un cliente abre 0..N incidencias; cada incidencia puede referirse a una&lt;br&gt;&amp;nbsp;&amp;nbsp;de sus cajas (o a ninguna).&lt;br&gt;· Al borrar un cliente se borran sus cajas e incidencias (ON DELETE CASCADE);&lt;br&gt;&amp;nbsp;&amp;nbsp;al borrar una caja, sus incidencias quedan sin caja (ON DELETE SET NULL).&lt;br&gt;· incidencias.estado solo admite: abierta, en curso o cerrada (restricción CHECK).&lt;br&gt;· intentos_fallidos guarda los inicios de sesión fallidos para bloquear&lt;br&gt;&amp;nbsp;&amp;nbsp;ataques de fuerza bruta (se borran a las 24 h)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="80" width="600" height="170" as="geometry"/></mxCell><mxCell id="c81" value="PK = clave primaria · FK = clave foránea · UQ = valor único" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="770" y="260" width="400" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
