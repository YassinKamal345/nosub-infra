; Gestionado por Ansible (nosub-infra/roles/gitea). Los cambios a mano se pierden.
APP_NAME = {{ gitea_nombre }}
RUN_USER = {{ gitea_usuario }}
RUN_MODE = prod
WORK_PATH = {{ gitea_dir_datos }}

[server]
PROTOCOL = http
HTTP_ADDR = 0.0.0.0
HTTP_PORT = {{ gitea_puerto_web }}
DOMAIN = {{ gitea_ip }}
ROOT_URL = http://{{ gitea_ip }}:{{ gitea_puerto_web }}/
START_SSH_SERVER = true
SSH_DOMAIN = {{ gitea_ip }}
SSH_PORT = {{ gitea_puerto_ssh }}
SSH_LISTEN_PORT = {{ gitea_puerto_ssh }}
LFS_START_SERVER = true
LFS_JWT_SECRET = {{ vault_gitea.lfs_jwt_secret }}
OFFLINE_MODE = true

[database]
DB_TYPE = {{ gitea_bd }}
PATH = {{ gitea_dir_datos }}/data/gitea.db

[repository]
ROOT = {{ gitea_dir_datos }}/repositorios
DEFAULT_BRANCH = main

[security]
INSTALL_LOCK = true
SECRET_KEY = {{ vault_gitea.secret_key }}
INTERNAL_TOKEN = {{ vault_gitea.internal_token }}
PASSWORD_HASH_ALGO = argon2

[oauth2]
JWT_SECRET = {{ vault_gitea.oauth2_jwt_secret }}

[service]
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = true
DEFAULT_KEEP_EMAIL_PRIVATE = true

[mailer]
ENABLED = false

[log]
MODE = console
LEVEL = info
