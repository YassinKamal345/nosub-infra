#!/bin/sh
# Gestionado por Ansible (nosub-infra/roles/gns3): {{ nombre }} en el ensayo de GNS3 ({{ r.papel }}).
# Lo mismo que network/generado/{{ nombre }}.cfg (Cisco), con FRRouting y Linux.
#   eth0 = {{ r.puerto_wan }} (red del centro, por DHCP) · eth1 = {{ r.puerto_sede }} (SW1, VLAN {{ vlan_enlace_r1.id }})
#   {% for e in enlaces_serie %}eth{{ loop.index + 1 }} = {{ e.r1 }} (con {{ e.cliente }}){{ ' · ' if not loop.last }}{% endfor %}

#   Los enlaces serie del material real son aquí enlaces Ethernet directos (en Docker no hay puertos serie).
set -e
for i in eth0 eth1{% for e in enlaces_serie %} eth{{ loop.index + 1 }}{% endfor %}; do ip link set $i up; done
ip addr add {{ r.ip_enlace }} dev eth1          # enlace con OPNsense (WAN de la sede)
{% for e in enlaces_serie %}
ip addr add {{ e.red | ansible.utils.ipaddr('1') }} dev eth{{ loop.index + 1 }}      # "Internet" simulado: {{ e.cliente }}
{% endfor %}
udhcpc -i eth0 -b -S                                     # IP de la red del centro
sysctl -w net.ipv4.ip_forward=1 >/dev/null
# NAT: lo que sale al centro usa la IP de {{ nombre }}
iptables -t nat -A POSTROUTING -o eth0 -s {{ vlan_enlace_r1.red }} -j MASQUERADE
iptables -t nat -A POSTROUTING -o eth0 -s {{ red_proveedor }} -j MASQUERADE
# Lo que entra desde el centro hacia la WAN de OPNsense
{% for f in r.reenvios %}
iptables -t nat -A PREROUTING -i eth0 -p {{ f.proto }} --dport {{ f.publico }} -j DNAT --to-destination {{ vlan_enlace_r1.red | ansible.utils.ipaddr('2') | ansible.utils.ipaddr('address') }}:{{ f.puerto }}   # {{ f.para }}
{% endfor %}
cp /etc/nosub/frr.conf /etc/frr/frr.conf
sed -i 's/^ospfd=no/ospfd=yes/' /etc/frr/daemons
exec /usr/lib/frr/docker-start
