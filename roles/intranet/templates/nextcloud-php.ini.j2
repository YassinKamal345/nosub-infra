; Gestionado por Ansible (nosub-infra/roles/intranet): valores que pide Nextcloud
memory_limit = 512M
upload_max_filesize = {{ nube_subida_max }}
post_max_size = {{ nube_subida_max }}
max_execution_time = 360
output_buffering = 0
date.timezone = Europe/Madrid
opcache.enable = 1
opcache.interned_strings_buffer = 32
opcache.max_accelerated_files = 10000
opcache.memory_consumption = 128
opcache.save_comments = 1
opcache.revalidate_freq = 60
apc.enable_cli = 1
