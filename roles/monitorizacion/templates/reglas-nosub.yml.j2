# Generado por Ansible (nosub-infra, rol monitorizacion). Avisos que se ven en Grafana y en Prometheus.
groups:
  - name: sede
    rules:
      - alert: EquipoSinRespuesta
        expr: up{job="nodos"} == 0
        for: 2m
        labels: { gravedad: critica }
        annotations: { resumen: "{{ '{{' }} $labels.nombre {{ '}}' }} no responde desde hace 2 minutos" }
      - alert: CajaSinConexion
        expr: up{job="cajas"} == 0
        for: 5m
        labels: { gravedad: aviso }
        annotations: { resumen: "Una caja de cliente no responde por la VPN desde hace 5 minutos (cuál, en Grafana)" }   # sin nombres: el aviso sale a ntfy.sh (RGPD)
      - alert: ServicioCaido
        expr: probe_success == 0
        for: 2m
        labels: { gravedad: critica }
        annotations: { resumen: "{{ '{{' }} $labels.servicio {{ '}}' }} no responde como debe" }
      - alert: DhcpSinEscuchar
        expr: nosub_dhcp_escuchando == 0
        for: 2m
        labels: { gravedad: critica }
        annotations: { resumen: "El DHCP (Kea) no escucha: los equipos nuevos de la sede no reciben IP" }
      - alert: CertificadoCaducaPronto
        expr: (probe_ssl_earliest_cert_expiry - time()) / 86400 < 21
        for: 1h
        labels: { gravedad: aviso }
        annotations: { resumen: "El certificado de {{ '{{' }} $labels.servicio {{ '}}' }} caduca en {{ '{{' }} $value | humanize {{ '}}' }} días" }
      - alert: DiscoCasiLleno
        expr: 100 * (1 - node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) > 85
        for: 10m
        labels: { gravedad: aviso }
        annotations: { resumen: "Disco de {{ '{{' }} $labels.nombre {{ '}}' }} al {{ '{{' }} $value | humanize {{ '}}' }} %" }
      - alert: ActualizacionesParadas
        expr: (time() - nosub_actualizacion_ultima_ok) / 86400 > 3 or nosub_actualizacion_fallo == 1
        for: 1h
        labels: { gravedad: aviso }
        annotations: { resumen: "Las actualizaciones automáticas de {{ '{{' }} $labels.nombre {{ '}}' }} no terminan bien" }
      - alert: ReinicioPendiente
        expr: nosub_reinicio_pendiente == 1
        for: 7d
        labels: { gravedad: aviso }
        annotations: { resumen: "{{ '{{' }} $labels.nombre {{ '}}' }} lleva una semana esperando un reinicio por un parche" }
      - alert: MemoriaCasiLlena
        expr: 100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) > 90
        for: 10m
        labels: { gravedad: aviso }
        annotations: { resumen: "RAM de {{ '{{' }} $labels.nombre {{ '}}' }} al {{ '{{' }} $value | humanize {{ '}}' }} %" }
