[Unit]
Description=Prometheus node_exporter (métricas del sistema; nosub-infra)
After=network-online.target
Wants=network-online.target

[Service]
User=node_exporter
ExecStart=/usr/local/bin/node_exporter --web.listen-address={{ node_exporter_ip }}:{{ node_exporter_puerto }} --collector.systemd
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
