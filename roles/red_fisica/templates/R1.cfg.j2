! {{ equipo }}: {{ r.papel }}
! Generado por Ansible (nosub-infra, rol red_fisica). No editar a mano: cambiar los datos y volver a generar.
{% include '_comun.j2' +%}
!
! ---------- Salida a la red del centro (Internet) ----------
interface {{ r.puerto_wan }}
 description Red del centro (Internet)
 ip address dhcp
 ip nat outside
 no shutdown
!
! ---------- Troncal hacia SW1 ----------
interface {{ r.puerto_troncal }}
 description Troncal a SW1 (VLANs {{ vlan_enlace_r1.id }} y {{ vlan_proveedor.id }})
 no ip address
 no shutdown
interface {{ r.puerto_troncal }}.{{ vlan_enlace_r1.id }}
 description Enlace con OPNsense (WAN de la sede)
 encapsulation dot1Q {{ vlan_enlace_r1.id }}
 ip address {{ r.ip_enlace | ansible.utils.ipaddr('address') }} {{ r.ip_enlace | ansible.utils.ipaddr('netmask') }}
 ip nat inside
interface {{ r.puerto_troncal }}.{{ vlan_proveedor.id }}
 description Internet simulado (clientes)
 encapsulation dot1Q {{ vlan_proveedor.id }}
 ip address {{ r.ip_proveedor | ansible.utils.ipaddr('address') }} {{ r.ip_proveedor | ansible.utils.ipaddr('netmask') }}
 ip nat inside
!
interface Loopback0
 ip address {{ r.loopback }} 255.255.255.255
!
! ---------- NAT: todo lo que sale al centro usa la IP de R1 ----------
ip access-list standard NAT-SALIDA
 permit {{ vlan_enlace_r1.red | ansible.utils.ipaddr('network') }} {{ vlan_enlace_r1.red | ansible.utils.ipaddr('hostmask') }}
 permit {{ vlan_proveedor.red | ansible.utils.ipaddr('network') }} {{ vlan_proveedor.red | ansible.utils.ipaddr('hostmask') }}
ip nat inside source list NAT-SALIDA interface {{ r.puerto_wan }} overload
!
! ---------- OSPF: da a R2 y R3 la ruta por defecto y la WAN de la sede ----------
router ospf 1
 router-id {{ r.loopback }}
 passive-interface default
 no passive-interface {{ r.puerto_troncal }}.{{ vlan_proveedor.id }}
 network {{ r.loopback }} 0.0.0.0 area 0
 network {{ vlan_enlace_r1.red | ansible.utils.ipaddr('network') }} {{ vlan_enlace_r1.red | ansible.utils.ipaddr('hostmask') }} area 0
 network {{ vlan_proveedor.red | ansible.utils.ipaddr('network') }} {{ vlan_proveedor.red | ansible.utils.ipaddr('hostmask') }} area 0
 default-information originate
!
{% include '_vty.j2' +%}
!
end
