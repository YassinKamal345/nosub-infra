# Gestionado por Ansible (nosub-infra/roles/traefik): webs publicadas y certificado
http:
  routers:
{% for s in traefik_sitios %}
    {{ s.nombre }}:
      # Un nombre "*.algo" acepta cualquier subdominio de un nivel (HostRegexp); el resto, nombre exacto (Host)
      rule: '{% for n in s.nombres %}{% if n.startswith("*.") %}HostRegexp(`^[a-z0-9-]+{{ n[1:] | regex_escape }}$`){% else %}Host(`{{ n }}`){% endif %}{{ " || " if not loop.last }}{% endfor %}'
      entryPoints: [websecure]
      service: {{ s.nombre }}
      middlewares: [seguridad]
      tls: {}
{% if s.limitar is defined %}
    # Inicio de sesión: como mucho {{ s.limitar.por_minuto }} intentos por minuto desde la misma IP (fuerza bruta)
    {{ s.nombre }}-limitado:
      rule: '({% for n in s.nombres %}Host(`{{ n }}`){{ " || " if not loop.last }}{% endfor %}) && Path(`{{ s.limitar.ruta }}`) && Method(`POST`)'
      entryPoints: [websecure]
      service: {{ s.nombre }}
      middlewares: [seguridad, {{ s.nombre }}-limite]
      tls: {}
{% endif %}
{% endfor %}
  services:
{% for s in traefik_sitios %}
    {{ s.nombre }}:
      loadBalancer:
        servers: [{ url: "{{ s.destino }}" }]
{% if s.salud is defined %}
        healthCheck: { path: "{{ s.salud }}", interval: 30s }
{% endif %}
{% endfor %}
  middlewares:
{% for s in traefik_sitios if s.limitar is defined %}
    {{ s.nombre }}-limite:
      rateLimit:
        average: {{ s.limitar.por_minuto }}
        period: 1m
        burst: {{ s.limitar.por_minuto }}
{% endfor %}
    seguridad:
      headers:
        stsSeconds: 31536000          # el navegador recuerda que esta web va siempre por HTTPS
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: same-origin

tls:
  certificates:                       # con sniStrict solo se aceptan los nombres de los certificados de esta lista
    - certFile: {{ traefik_dir_config }}/certs/traefik.crt
      keyFile: {{ traefik_dir_config }}/certs/traefik.key
  options:
    default: { minVersion: VersionTLS12, sniStrict: true }
  stores:
    default:
      defaultCertificate:
        certFile: {{ traefik_dir_config }}/certs/traefik.crt
        keyFile: {{ traefik_dir_config }}/certs/traefik.key
