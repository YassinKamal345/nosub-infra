# Gestionado por Ansible (nosub-infra/roles/traefik)
[Unit]
Description=Traefik (proxy inverso con HTTPS de la DMZ de {{ empresa }})
After=network-online.target
Wants=network-online.target

[Service]
User={{ traefik_usuario }}
Group={{ traefik_usuario }}
ExecStart=/usr/local/bin/traefik --configFile={{ traefik_dir_config }}/traefik.yml
# Puede abrir los puertos 80 y 443 sin ser root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
